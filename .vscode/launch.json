{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Host FastAPI Server",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "jinja": true,
            "python": "${workspaceFolder}/.venv/Scripts/python.exe"
        }
    ]
}
