# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Local storage configuration
CHROMA_DB_PATH=data/chroma_db
SQLITE_DB_PATH=data/metadata.db
PORT=8000
HOST=127.0.0.1
MOCK_EMBEDDINGS=false
RETRIEVAL_THRESHOLD=0.8

# JWT security settings
# WARNING: Change this key to a strong random 32-byte hex string in production (e.g. generate via `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET_KEY=9a7c36d0b8f15d2a938c2014e7a83d7bb024debfcb6b1a3e78b4a7df2cb6b4d3
JWT_ALGORITHM=HS256

# CORS origin policy (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
